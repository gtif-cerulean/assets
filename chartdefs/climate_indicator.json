{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 300,
    "data": {
        "name": "process_eox"
    },
    "transform": [
      {
        "calculate": "toDate(-2208988800000 + datum.time * 86400000)",
        "as": "datetransformed"
      }
    ],
    "layer": [
      {
        "mark": "area",
        "encoding": {
          "x": {"field": "datetransformed", "type": "temporal", "title": "Time"},
          "y": {
            "field": "siextentn_min",
            "type": "quantitative",
            "title": "siextentn range"
          },
          "y2": {"field": "siextentn_max"},
          "color": {"value": "steelblue"},
          "opacity": {"value": 0.5}
        }
      },
      {
        "mark": "point",
        "encoding": {
          "x": {"field": "datetransformed", "type": "temporal"},
          "y": {"field": "siextentn_min", "type": "quantitative"}
        }
      },
      {
        "mark": "point",
        "encoding": {
          "x": {"field": "datetransformed", "type": "temporal"},
          "y": {"field": "siextentn_max", "type": "quantitative"}
        }
      }
    ]
  }