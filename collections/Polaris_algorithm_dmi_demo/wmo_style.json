{
    "jsonform": {
      "type": "object",
      "title": "Data configuration",
      "properties": {
        "type_of_visualisation": {
          "title": "Type of Visualisation",
          "type": "string",
          "enum": ["WMO Concentration", "WMO Stage of Development"],
          "default": "POLARIS"
        }
      }
    },
    "variables": {
      "type_of_visualisation": "WMO Concentration"
