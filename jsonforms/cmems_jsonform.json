{
    "type": "object",
    "properties": {
        "bbox": {
            "type": "array",
            "title": "Select area on map",
            "options": {
                "autoStartSelection": false,
                "drawtools": {
                    "for": "eox-map#main",
                    "projection": "EPSG:4326"
                }
            },
            "format": "bounding-box"
        },
        "date_start": {
            "title": "Select start date",
            "type": "date",
            "format": "date",
            "default": "2025-01-01"
        },
        "date_end": {
            "title": "Select end date",
            "type": "date",
            "format": "date",
            "default": "2025-12-31"
        },
        "depth": {
            "type": "number",
            "title": "Depth [m]",
            "minimum": 0,
            "maximum": 5500,
            "steps": 1,
            "default": 1,
            "format": "range",
            "options": {
              "hidden": true
            }
        }
    }
}
