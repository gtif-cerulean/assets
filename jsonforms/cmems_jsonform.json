{
    "type": "object",
    "properties": {
        "bbox": {
            "type": "array",
            "title": "Select area on map",
            "options": {
                "for": "eox-map#main",
                "projection": "EPSG:4326"
            },
            "format": "bounding-box"
        },
        "date_start": {
            "title": "Select start date",
            "type": "date",
            "format": "date",
            "default": "2024-09-01"
        },
        "date_end": {
            "title": "Select end date",
            "type": "date",
            "format": "date",
            "default": "2024-12-20"
        },
        "depth": {
            "type": "number",
            "title": "Depth [m]",
            "minimum": -5500,
            "maximum": 0,
            "steps": 100,
            "default": 0,
            "format": "range",
            "options": {
              "hidden": true
            }
        }
    }
}