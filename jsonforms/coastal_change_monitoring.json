{
    "type": "object",
    "properties": {
        "aoi_json": {
            "type": "array",
            "title": "Select area (bbox) on map",
            "options": {
                "autoStartSelection": false,
                "drawtools": {
                    "for": "eox-map#main",
                    "projection": "EPSG:4326"
                }
            },
            "format": "bounding-box"
        },
        "query_date": {
            "title": "Select date",
            "type": "date",
            "format": "date",
            "default": "2025-01-31"
        },
        "cloud_cover": {
            "title": "Maximum Cloud Cover",
            "type": "number",
            "format": "number",
            "default": 10
        }
    }
}
